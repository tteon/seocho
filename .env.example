# SEOCHO Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# GitHub
GITHUB_TOKEN=ghp_your_token_here

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible providers (optional)
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# DASHSCOPE_API_KEY=

# Neo4j Graph Storage
# Host-side scripts and SDK runs should use localhost.
# Docker services in docker-compose.yml already override their internal
# connection string to `bolt://neo4j:7687`.
SEOCHO_BIND_HOST=127.0.0.1
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Optional Unix socket for the local Rust `seochod` approved projection daemon.
# SEOCHO_RUST_PROJECTOR_SOCKET=/tmp/seochod.sock
# Opt into receipt-enforced canonical projection only after offline RDF governance.
# SEOCHO_RDF_GOVERNANCE_RECEIPT=./.seocho/ontology/current/governance-receipt.json
# SEOCHO_AGENT_ONTOLOGY_PROFILE=./.seocho/ontology/current/agent-profiles/projection.json
# SEOCHO_ONTOLOGY_STATE_DB=./.seocho/ontology/state.sqlite
# SEOCHO_ONTOLOGY_LEASE_ID=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
SEOCHO_GRAPH_REGISTRY_FILE=extraction/conf/graphs/default.yaml

# Authoritative PostgreSQL agent memory (docker-compose.memory.yml)
POSTGRES_USER=seocho
# POSTGRES_PASSWORD=
POSTGRES_DB=seocho_memory
POSTGRES_PORT=55432
# Override for isolated qualification runs; changing this creates a new database.
POSTGRES_VOLUME_NAME=seocho-postgres-memory-v18
# Optional full override used by SDK, migration, benchmark, and smoke commands.
# SEOCHO_POSTGRES_DSN=postgresql://seocho:password@127.0.0.1:55432/seocho_memory

# Application Services
EXTRACTION_API_PORT=8001
EXTRACTION_NOTEBOOK_PORT=8888
# Internal proxy target used by evaluation-interface.
EXTRACTION_SERVICE_URL=http://extraction-service:8001
# Thin local UI proxy port.
CHAT_INTERFACE_PORT=8501

# Observability contract
# Choose one of: none | console | jsonl | opik
SEOCHO_TRACE_BACKEND=none
SEOCHO_TRACE_JSONL_PATH=./traces/seocho-runtime.jsonl
# OpenAI Agents SDK tracing is disabled by default (its default exporter phones
# home to OpenAI and needs an OpenAI key; SEOCHO tracing is vendor-neutral,
# ADR-0216). Set to 1/true to opt the SDK exporter back in.
# SEOCHO_AGENTS_SDK_TRACING=

# FinDER tutorials (docker-compose.tutorials.yml)
# Fully embedded — JupyterLab only, no external graph server.
# LPG runs on LanceDB; RDF/OWL runs on owlready2; both inside the container.
TUTORIALS_JUPYTER_PORT=8888
# Neo4j (DozerDB) for the tutorial graph backend. Standard ports — if
# something else holds 7474/7687 (main `make up` stack, system Neo4j,
# leftover Docker proxy), override here. `make tutorials-down` is
# usually enough to release stale Docker-side bindings.
TUTORIALS_NEO4J_HTTP_PORT=7474
TUTORIALS_NEO4J_BOLT_PORT=7687
TUTORIALS_NEO4J_PASSWORD=tutorialspw
# LLM provider for completions in the four FinDER tutorials. Format:
# provider/model. Supported providers: openai, deepseek, kimi, grok, qwen.
# Whichever provider you pick, set its API key above.
# Note: OPENAI_API_KEY is still needed for Tutorial 1's vector path
# because only OpenAI supports embeddings in seocho today.
SEOCHO_LLM=openai/gpt-4o-mini
# Override to point all four FinDER notebooks at a real FinDER JSON.
# FINDER_PATH=/workspace/examples/datasets/finder_full.json

# Miscellaneous
# TIMEZONE was declared here and read by nothing -- not by the code, not by any
# compose file. Container images read `TZ`, so set that instead if you need one.
# TZ=UTC
# HF_TOKEN=

# Serving image: opt-in extras (extraction/entrypoint.sh)
# The image serves the API. Jupyter and the batch pipeline used to run beside it
# unconditionally; both are now off by default.
#   SEOCHO_ENABLE_JUPYTER=1 requires SEOCHO_JUPYTER_TOKEN. A tokenless notebook
#   server is remote code execution for anyone who can reach the port, with
#   every secret below in its environment.
SEOCHO_ENABLE_JUPYTER=0
# SEOCHO_JUPYTER_TOKEN=
#   A full extraction run on every container start becomes N concurrent ingests
#   at N replicas, racing the same graph.
SEOCHO_RUN_BATCH_ON_START=0
# Access control. runtime/identity.py defaults to "none" (anonymous); compose
# now requires you to state the choice rather than inherit it.
SEOCHO_AUTH_MODE=none
# ====================================================================
# Everything below was added by scripts/ci/check-env-contract.py, which
# compares this file against what the code and the compose files actually
# read. Before it existed the three disagreed: code read 73 variables,
# compose referenced 66, and this file declared 44 -- omitting the graph
# backend and the default LLM provider, so nobody could start the system
# from the documented surface alone.
# ====================================================================

