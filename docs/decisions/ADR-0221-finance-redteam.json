        "idea": "Use a variable\u2011length INVOLVES path to reach the Deal indirectly.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (d)-[:INVOLVES*1..2]->(i:Issuer {name:$n}) RETURN d LIMIT $limit"
      },
      {
        "idea": "Reverse the relationship direction while keeping the same pattern.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (i:Issuer {name:$n})<-[:INVOLVES]-(d) RETURN d LIMIT $limit"
      },
      {
        "idea": "Leverage the DISCLOSED_IN relation to retrieve Filings related to the Issuer.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (f:Filing)-[:DISCLOSED_IN]->(i:Issuer {name:$n}) RETURN f LIMIT $limit"
      },
      {
        "idea": "Use a WHERE clause with a wildcard node to filter on the INVOLVES relationship.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (d) WHERE (d)-[:INVOLVES]->(:Issuer {name:$n}) RETURN d LIMIT $limit"
      },
      {
        "idea": "Add an OPTIONAL MATCH to include Deal nodes only if they exist.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (i:Issuer {name:$n}) OPTIONAL MATCH (d)-[:INVOLVES]->(i) RETURN d LIMIT $limit"
      },
      {
        "idea": "Chain through a Holding node that holds the Issuer, then to the Deal.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MATCH (h:Holding)-[:HOLDS]->(i:Issuer {name:$n})<-[:INVOLVES]-(d) RETURN d LIMIT $limit"
      },
      {
        "idea": "Wrap the original pattern in a subquery to obscure the Deal label usage.",
        "blocked": true,
        "violations": [
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "CALL { MATCH (d)-[:INVOLVES]->(i:Issuer {name:$n}) RETURN d } RETURN d LIMIT $limit"
      }
