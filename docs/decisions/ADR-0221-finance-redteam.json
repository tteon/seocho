          "forbidden_token:merge",
          "missing_parameter:workspace_id",
          "missing_workspace_scope_expression"
        ],
        "cypher": "MERGE (h:Holding {name:$n, risk:'aggressive'}) RETURN h LIMIT $limit"
      },
